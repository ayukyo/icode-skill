{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ICODE lite independent review",
  "type": "object",
  "required": ["schema_version", "attempt", "candidate_id", "contract_digest", "verdict", "findings", "criteria", "requirement_assessment", "implementation_assessment"],
  "properties": {
    "schema_version": {"const": 1},
    "attempt": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"enum": ["pass", "changes_required", "blocked"]},
    "requirement_assessment": {"type": "string", "minLength": 1},
    "implementation_assessment": {"type": "string", "minLength": 1},
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "status", "evidence"],
        "properties": {"id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "pending_external"]},
          "evidence": {"type": "string", "minLength": 1}}}
    },
    "findings": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "blocking", "status", "description", "evidence"],
        "properties": {"id": {"type": "string", "minLength": 1}, "blocking": {"type": "boolean"},
          "status": {"enum": ["open", "fixed_pending_review", "resolved"]},
          "description": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}}}
    }
  }
}
