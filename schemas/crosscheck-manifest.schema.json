{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "crosscheck-manifest.schema.json",
  "title": "ICODE crosscheck manifest v1",
  "description": "独立复评容器合同；不是 ticket metadata，不得进入工单索引或状态机。",
  "type": "object",
  "required": ["schema_version", "crosscheck_id", "target", "created_at", "updated_at", "current_round", "rounds"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "crosscheck_id": { "type": "string", "pattern": "^crosscheck-[0-9a-f]{16}$" },
    "target": {
      "type": "object",
      "required": ["ticket_id", "ticket_dir", "project_root", "status", "metadata_schema_version"],
      "additionalProperties": false,
      "properties": {
        "ticket_id": { "type": "string", "minLength": 1 },
        "ticket_dir": { "type": "string", "minLength": 1 },
        "project_root": { "type": "string", "minLength": 1 },
        "status": { "const": "completed" },
        "metadata_schema_version": { "type": ["integer", "null"] }
      }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "current_round": { "type": "integer", "minimum": 1 },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["round", "state", "phase", "started_at", "start_snapshot", "start_snapshot_digest", "fresh_file", "final_file"],
        "additionalProperties": false,
        "properties": {
          "round": { "type": "integer", "minimum": 1 },
          "state": { "enum": ["in_progress", "completed", "blocked", "stale_input"] },
          "phase": { "enum": ["fresh_review", "history_compare", "finalized"] },
          "started_at": { "type": "string", "minLength": 1 },
          "finished_at": { "type": "string" },
          "start_snapshot": { "type": "object" },
          "start_snapshot_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "fresh_file": { "type": "string", "pattern": "^crosscheck_round_[1-9][0-9]*\\.fresh\\.json$" },
          "fresh_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "final_file": { "type": "string", "pattern": "^crosscheck_round_[1-9][0-9]*\\.json$" },
          "final_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "inspection_version": { "const": 1 },
          "inspection_declaration_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "worklist_file": { "type": "string", "pattern": "^crosscheck_round_[1-9][0-9]*\\.worklist\\.json$" },
          "worklist_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "round_markdown_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "verdict": { "enum": ["pass", "pass_with_suggestions", "changes_recommended", "blocked"] },
          "stale_snapshot_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
