{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only deterministic inspection worklist",
  "description": "Declarations/hashes cannot prove actual Read or judgment. Rules do not replace project LIMIT. Runtime validation independently re-derives required files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace", "step", "ticket_id", "attempt", "mode", "required_phases", "code_files", "related", "scopes", "baselines", "resolved_baselines", "max_files", "max_bytes", "units", "exclusions", "unobserved", "findings", "coverage_status"],
  "properties": {
    "schema_version": {"const": 1},
    "workspace": {"type": "string", "pattern": "^/"},
    "step": {"enum": ["code", "deepcheck", "audit", "crosscheck"]},
    "ticket_id": {"type": "string", "minLength": 1},
    "attempt": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]},
    "mode": {"enum": ["full", "fast"]},
    "required_phases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["code_review", "reverse", "fixed", "free", "audit", "fresh"]}},
    "code_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "related": {"$ref": "#/$defs/paths"},
    "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "baselines": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "resolved_baselines": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}},
    "max_files": {"type": "integer", "minimum": 1},
    "max_bytes": {"type": "integer", "minimum": 1},
    "units": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["unit_id", "files"], "properties": {"unit_id": {"$ref": "#/$defs/hash"}, "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}}}},
    "exclusions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "reason"], "properties": {"path": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}},
    "unobserved": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "debt_reason"], "properties": {"path": {"type": "string", "minLength": 1}, "debt_reason": {"type": "string", "minLength": 1}}}},
    "coverage_status": {"enum": ["complete_within_scope", "partial", "degraded"]},
    "findings": {"type": "array", "items": {"type": "object"}},
    "debt_reason": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)(?:\\.git|\\.icode_output)(?:/|$))[^\\u0000\\\\]+$"},
    "paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "kind", "reason", "rules", "reads"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"},
        "kind": {"enum": ["file", "deleted"]}, "reason": {"type": "string", "minLength": 1},
        "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reads": {"type": "object", "propertyNames": {"enum": ["code_review", "reverse", "fixed", "free", "audit", "fresh"]}, "additionalProperties": {"$ref": "#/$defs/hash"}}
      }
    }
  }
}
