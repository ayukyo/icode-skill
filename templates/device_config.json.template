{
  "project_id": "<project_id>",
  "device_config": {
    "deploy_enabled": false,
    "note": "安装本 SKILL 后，复制本模板到 ~/.claude/icode_data/device_config/<project_id>.json 并填写真实值。deploy_enabled=false 时 patch 跳过实机部署验证（可选）。deploy/log 均为配置项，由用户按工程实际情况填写。支持单个连接或多个连接，patch 验证时按 name 选用。",
    "connections": [
      {
        "name": "adb_main",
        "type": "adb",
        "serial": "<设备序列号>",
        "deploy": "adb -s <serial> push <artifact> <target>",
        "log": "adb -s <serial> logcat"
      },
      {
        "name": "ssh_main",
        "type": "ssh",
        "host": "<ip>",
        "port": 22,
        "user": "<user>",
        "password": "",
        "deploy": "scp <artifact> <user>@<host>:<target>",
        "log": "ssh <user>@<host> 'find <log_dir> -type f -newer /tmp/.icode_marker 2>/dev/null'",
        "log_note": "ssh 场景看某目录下多份日志文件，且常含多层子目录（如 daily/、boot/ 子目录），用递归 find 覆盖全部层；增量用 marker 文件记录上次轮询时间，marker 放日志目录外（如 /tmp/.icode_marker）避免被 find 自身算作日志；每轮轮询后 touch marker 只取新增/变更文件；追加式单文件场景可改用 tail"
      },
      {
        "name": "serial_debug",
        "type": "serial",
        "port": "/dev/ttyUSB0",
        "baud": 115200,
        "deploy": "",
        "log": "minicom -D <port> -b <baud>"
      }
    ]
  }
}
