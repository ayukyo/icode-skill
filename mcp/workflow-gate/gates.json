{
  "schema_version": 1,
  "doc": "workflow gate（工作流硬门禁）机器真源。文档只解释语义，门禁触发条件、阻断步骤与校验规则一律从本文件读取，禁止在 step 文档/脚本中各自写一套常量。step 文档中的描述必须与本文件一致；若不一致以本文件为校验真源。本文件实现 WORKFLOW_OPTIMIZATION_PROPOSAL.md 的 P0 四类硬门禁 + P1 生命周期验收收敛。校验器为 tools/lint_workflow_contract.py（显式分支计算，不引入通用表达式解释器；condition 字段供人审与测试锚点）。",
  "constants": {
    "impact_checklist_dimensions": [
      "authoritative_writer",
      "persistent_references",
      "derived_metadata",
      "runtime_indexes",
      "queries_and_selectors",
      "async_links",
      "recovery_paths",
      "external_projections",
      "rollback_and_failure"
    ],
    "acceptance_phases": ["immediate", "converged", "restart", "replay"],
    "acceptance_consumers": [
      "direct_query",
      "aggregate_selector",
      "persistent_reference",
      "external_projection"
    ],
    "verification_layers": [
      "static",
      "unit",
      "build",
      "host",
      "deploy",
      "delivery",
      "consumption",
      "settings_preview",
      "operation_view",
      "closed_client",
      "physical"
    ],
    "fast_risk_triggers": [
      "cross_component",
      "persistent_identity_change",
      "dependency_migration",
      "async_observer_or_cache",
      "restart_replay_semantics",
      "external_consumer_change",
      "real_env_verification",
      "unresolved_semantic_decision",
      "major_requirement_delta"
    ],
    "major_delta_severity": "major",
    "delta_terminal_classifications": [
      "clarification_only",
      "a_now_with_evidence",
      "needs_user_confirm",
      "needs_replan"
    ]
  },
  "semantic_decision_gate": {
    "doc": "语义决策门禁：任一分析/计划/评审出现外部行为不同的多方案、或存在未定义/待确认/策略不唯一结论时，必须先把决策写入结构化合同（semantic_decisions），未解决前禁止进入实现阶段。禁止以「最保守/最安全/通常如此」代替用户选择。",
    "trigger_conditions": [
      "同一输入存在两种及以上会改变外部行为的处理方式",
      "结论含待确认/未定义/需要选择/策略不唯一",
      "需要决定允许/拒绝/合并/替换/保留/迁移",
      "需要决定存活身份/冲突优先级/兼容阈值/失败语义",
      "当前证据只能说明缺少机制，不能唯一推导期望行为"
    ],
    "terminal_states": ["resolved"],
    "diagnosis_only_marker": "diagnosis-only",
    "blocked_steps": ["plan", "code", "patch"],
    "block_condition": "存在 semantic_decisions[].status != resolved 且非 diagnosis-only → plan/code/patch 阻断"
  },
  "identity_change_gate": {
    "doc": "身份变化影响门禁：设计/代码涉及合并、删除、去重、重命名、重新分配实体身份、实体替代、依赖归属变化、权威状态与运行时投影不一致、旧身份提交后不应继续被查询/枚举/执行时，必须填完整 9 维影响清单（impact_contract），身份变化未填完整前禁止进入编码或部署。",
    "trigger_conditions": [
      "合并/删除/去重/重命名/重新分配实体身份",
      "一个实体替代另一个实体",
      "依赖关系的归属对象发生变化",
      "权威状态与运行时投影的实体集合可能不同",
      "旧身份在提交后不应继续被查询/枚举/执行"
    ],
    "checklist": [
      {"key": "authoritative_writer", "question": "哪个组件决定最终实体集合和存活身份？"},
      {"key": "persistent_references", "question": "哪些依赖记录保存实体身份？如何迁移或清理？"},
      {"key": "derived_metadata", "question": "归属、计数、汇总值是否需要重算？"},
      {"key": "runtime_indexes", "question": "缓存、注册表、索引是否删除已淘汰身份？"},
      {"key": "queries_and_selectors", "question": "单项查询、全选、批量选择是否只返回存活实体？"},
      {"key": "async_links", "question": "观察者乱序、延迟刷新时是否会产生短暂错误状态？"},
      {"key": "recovery_paths", "question": "重启、重放、幂等重试能否得到相同结果？"},
      {"key": "external_projections", "question": "下游消费者收到的身份、顺序和数量是否一致？"},
      {"key": "rollback_and_failure", "question": "中途失败时权威状态和派生状态是否保持原样？"}
    ],
    "status_enum": ["affected", "not-affected", "unassessed"],
    "completeness_enum": ["complete", "incomplete"],
    "block_condition": "impact_contract.identity_change == true 且 completeness != complete → code/deploy 阻断",
    "blocked_steps": ["code", "deploy", "audit-verified"]
  },
  "requirement_delta_escalation": {
    "doc": "需求增量强制升级：把 requirement_deltas 从记录项升级为流程控制项。severity=major 且 needs_replan=true 未回流重定稿时，当前阶段必须终止并路由回 plan/review，patch 不得静默吸收重大增量；轻量修补只允许处理不改变合同的实现缺陷。",
    "major_severities": ["major"],
    "major_triggers": [
      "新增或改变操作入口",
      "从拒绝改为允许，或从保留改为收敛",
      "改变存活身份/依赖迁移/失败语义",
      "改变持久化/事务/回滚/恢复行为",
      "新增跨组件/跨仓库/外部消费者影响",
      "原计划只覆盖单体场景，新需求增加传递关联或多实体场景",
      "原验证边界扩大到真实环境/重启/异步收敛"
    ],
    "needs_replan_route": [
      "需求增量",
      "更新范围合同",
      "补齐语义决策",
      "重建影响合同",
      "更新验收矩阵",
      "重新评审",
      "才能继续实现"
    ],
    "block_condition": "存在 severity=major 且 needs_replan=true 且 status != resolved → 阻断当前阶段并路由回 plan/review",
    "lightweight_allowed": "仅处理不改变合同的实现缺陷"
  },
  "fast_risk_upgrade": {
    "doc": "快速模式风险自动升级：fast 模式命中任一风险标志时 effective_mode 自动设为 full；允许用户显式 override 但必须记录风险接受事实（risk_profile.override=true）。低风险、单文件、纯计算且无外部状态变化的任务仍可保持 fast。",
    "effective_mode_full": "full",
    "risk_flags": {
      "cross_component": "跨组件修改",
      "persistent_identity_change": "持久化实体身份变化",
      "dependency_migration": "依赖关系迁移",
      "async_observer_or_cache": "异步观察者、缓存或注册表参与",
      "restart_replay_semantics": "重启、恢复或重放语义受影响",
      "external_consumer_change": "外部消费者行为发生变化",
      "real_env_verification": "需要真实环境验证",
      "unresolved_semantic_decision": "出现尚未解决的语义决策",
      "major_requirement_delta": "执行中发生重大需求增量"
    },
    "block_condition": "metadata.mode == fast 且任一 risk flag 为 true 且 (risk_profile.effective_mode != full 且 override != true) → 违规（须记录风险接受或自动升级 full）",
    "keeps_fast_allowed": "低风险、单文件、纯计算且无外部状态变化"
  },
  "acceptance_contract": {
    "doc": "生命周期验收合同：任何改变权威状态或实体身份的修改，必须覆盖四个阶段（即时/异步收敛/重启恢复/重复执行）与四类消费者（直接查询/聚合选择/依赖归属/外部投影）。只验证直接查询不能把任务标记为 verified。矩阵中任何必填单元为空 = 验证不完整。",
    "lifecycle_scopes": ["authoritative_state_change", "identity_change"],
    "verified_requires": "acceptance_contract.matrix 覆盖全部 required_phases × required_consumers 且无空 cell 才能 delivery_verdict=verified",
    "scenario_seed": [
      "等价",
      "单向包含",
      "部分关联",
      "仅边界接触",
      "无关联",
      "一个新实体同时关联多个既有实体",
      "多个输入构成传递关联",
      "存在依赖记录",
      "失败、重试和回滚"
    ]
  },
  "delivery_evidence_gate": {
    "doc": "显式分层交付证据门禁。verification_contract.required=true 时，verified 必须覆盖 required_layers × required_consumers × required_scenarios；每个单元取最新 verification_run，结果必须 pass，且 evidence 与 baseline 均非空。",
    "blocked_steps": ["audit-verified"],
    "block_condition": "verification_contract.required == true 且任一 required cell 缺失、最新 outcome != pass、evidence 为空或 baseline 为空 → 禁止 delivery_verdict=verified",
    "compatibility": "verification_contract 缺失或 required=false 时不强制，避免给非现场任务和历史工单虚构真机要求"
  },
  "legacy": {
    "untracked_marker": "legacy-untracked",
    "doc": "阶段一提示模式：旧工单缺少新字段时补默认值并标记 legacy-untracked，校验器输出警告不阻断只读审计；新任务从计划阶段开始执行硬门禁。阶段二强制模式由 --strict 开启（缺字段判失败）。",
    "defaults": {
      "semantic_decisions": [],
      "impact_contract": null,
      "acceptance_contract": null,
      "risk_profile": null,
      "diagnosis_only": false
    }
  },
  "execution_model": {
    "schema_version": 1,
    "doc": "借鉴行为树的端口、Reactive 边界检查、节点轨迹、Retry/Fallback 与长动作回执，但不引入行为树运行时、XML、全局黑板或常驻 tick。工单事件链是唯一执行账本；只有已显式 step start 的新执行受 step finish 约束，历史工单保持 legacy-untracked 兼容。",
    "boundaries": ["before_write", "after_wait", "before_side_effect", "before_transition"],
    "input_kinds": ["metadata_pointer", "ticket_file", "ticket_glob", "metadata_files", "workspace_git_head"],
    "output_kinds": ["metadata_pointer", "ticket_file", "ticket_glob", "metadata_files", "external_artifact"],
    "step_outcomes": ["success", "failure", "degraded", "blocked", "skipped"],
    "step_contracts": {
      "init": {
        "inputs": [
          {"id": "requirement", "kind": "metadata_pointer", "value": "/requirement", "required": true, "protected": true}
        ],
        "outputs": [{"id": "initial_requirement", "kind": "ticket_file", "value": "00_init.md"}],
        "required_checks": ["before_write"],
        "drift_routes": {"requirement": "plan", "default": "plan"}
      },
      "log": {
        "inputs": [
          {"id": "requirement", "kind": "metadata_pointer", "value": "/requirement", "required": true, "protected": true},
          {"id": "active_checkout", "kind": "metadata_pointer", "value": "/active_checkout", "required": false, "protected": true},
          {"id": "workspace_head", "kind": "workspace_git_head", "value": ".", "required": false, "protected": true}
        ],
        "outputs": [
          {"id": "log_analysis", "kind": "ticket_file", "value": "log_analysis.md"},
          {"id": "initial_requirement", "kind": "ticket_file", "value": "00_init.md"}
        ],
        "required_checks": ["before_write", "before_transition"],
        "drift_routes": {"requirement": "plan", "active_checkout": "worktree", "workspace_head": "review", "default": "review"}
      },
      "plan": {
        "inputs": [
          {"id": "requirement", "kind": "metadata_pointer", "value": "/requirement", "required": true, "protected": true},
          {"id": "scope", "kind": "metadata_pointer", "value": "/scope_contract", "required": false, "protected": true},
          {"id": "initial_requirement", "kind": "ticket_file", "value": "00_init.md", "required": false, "protected": true},
          {"id": "log_analysis", "kind": "ticket_file", "value": "log_analysis.md", "required": false, "protected": true}
        ],
        "outputs": [{"id": "plan", "kind": "ticket_file", "value": "01_plan.md"}],
        "required_checks": ["before_write", "before_transition"],
        "drift_routes": {"requirement": "plan", "scope": "plan", "initial_requirement": "plan", "log_analysis": "plan", "default": "plan"}
      },
      "review": {
        "inputs": [
          {"id": "plan", "kind": "ticket_file", "value": "01_plan.md", "required": true, "protected": true},
          {"id": "requirement", "kind": "metadata_pointer", "value": "/requirement", "required": true, "protected": true},
          {"id": "scope", "kind": "metadata_pointer", "value": "/scope_contract", "required": false, "protected": true}
        ],
        "outputs": [
          {"id": "review", "kind": "ticket_file", "value": "02_review.md"},
          {"id": "review_rounds", "kind": "ticket_glob", "value": "review_round_*.json", "required": false}
        ],
        "required_checks": ["before_write", "after_wait", "before_transition"],
        "drift_routes": {"plan": "review", "requirement": "plan", "scope": "plan", "default": "review"}
      },
      "merge": {
        "inputs": [
          {"id": "plan", "kind": "ticket_file", "value": "01_plan.md", "required": true, "protected": true},
          {"id": "review", "kind": "ticket_file", "value": "02_review.md", "required": true, "protected": true},
          {"id": "review_rounds", "kind": "ticket_glob", "value": "review_round_*.json", "required": false, "protected": true},
          {"id": "deltas", "kind": "metadata_pointer", "value": "/requirement_deltas", "required": false, "protected": true}
        ],
        "outputs": [{"id": "final_plan", "kind": "ticket_file", "value": "03_plan_final.md"}],
        "required_checks": ["before_write", "before_transition"],
        "drift_routes": {"plan": "review", "review": "review", "review_rounds": "review", "deltas": "plan", "default": "review"}
      },
      "code": {
        "inputs": [
          {"id": "final_plan", "kind": "ticket_file", "value": "03_plan_final.md", "required": true, "protected": true},
          {"id": "requirement", "kind": "metadata_pointer", "value": "/requirement", "required": true, "protected": true},
          {"id": "scope", "kind": "metadata_pointer", "value": "/scope_contract", "required": false, "protected": true},
          {"id": "deltas", "kind": "metadata_pointer", "value": "/requirement_deltas", "required": false, "protected": true},
          {"id": "active_checkout", "kind": "metadata_pointer", "value": "/active_checkout", "required": false, "protected": true},
          {"id": "workspace_head", "kind": "workspace_git_head", "value": ".", "required": false, "protected": true}
        ],
        "outputs": [
          {"id": "code_files", "kind": "metadata_files", "value": "/code_files", "base": "workspace"},
          {"id": "code_review", "kind": "ticket_file", "value": "04_code_review_fix.md"}
        ],
        "required_checks": ["before_write", "before_transition"],
        "drift_routes": {"final_plan": "review", "requirement": "plan", "scope": "plan", "deltas": "plan", "active_checkout": "worktree", "workspace_head": "merge", "default": "review"}
      },
      "deepcheck": {
        "inputs": [
          {"id": "final_plan", "kind": "ticket_file", "value": "03_plan_final.md", "required": true, "protected": true},
          {"id": "code_files", "kind": "metadata_files", "value": "/code_files", "base": "workspace", "required": true, "protected": true},
          {"id": "active_checkout", "kind": "metadata_pointer", "value": "/active_checkout", "required": false, "protected": true},
          {"id": "workspace_head", "kind": "workspace_git_head", "value": ".", "required": false, "protected": true}
        ],
        "outputs": [{"id": "deepcheck", "kind": "ticket_file", "value": "05_deepcheck.md"}],
        "required_checks": ["before_write", "after_wait", "before_transition"],
        "drift_routes": {"final_plan": "review", "code_files": "deepcheck", "active_checkout": "worktree", "workspace_head": "merge", "default": "deepcheck"}
      },
      "audit": {
        "inputs": [
          {"id": "final_plan", "kind": "ticket_file", "value": "03_plan_final.md", "required": true, "protected": true},
          {"id": "code_files", "kind": "metadata_files", "value": "/code_files", "base": "workspace", "required": true, "protected": true},
          {"id": "deepcheck", "kind": "ticket_file", "value": "05_deepcheck.md", "required": false, "protected": true},
          {"id": "active_checkout", "kind": "metadata_pointer", "value": "/active_checkout", "required": false, "protected": true},
          {"id": "workspace_head", "kind": "workspace_git_head", "value": ".", "required": false, "protected": true}
        ],
        "outputs": [{"id": "audit", "kind": "ticket_file", "value": "06_audit.md"}],
        "required_checks": ["before_write", "after_wait", "before_transition"],
        "drift_routes": {"final_plan": "review", "code_files": "deepcheck", "deepcheck": "deepcheck", "active_checkout": "worktree", "workspace_head": "merge", "default": "audit"}
      },
      "patch": {
        "inputs": [
          {"id": "final_plan", "kind": "ticket_file", "value": "03_plan_final.md", "required": false, "protected": true},
          {"id": "code_files", "kind": "metadata_files", "value": "/code_files", "base": "workspace", "required": false, "protected": true},
          {"id": "requirement", "kind": "metadata_pointer", "value": "/requirement", "required": true, "protected": true},
          {"id": "deltas", "kind": "metadata_pointer", "value": "/requirement_deltas", "required": false, "protected": true}
        ],
        "outputs": [
          {"id": "patch", "kind": "ticket_file", "value": "08_patch.md"},
          {"id": "code_files", "kind": "metadata_files", "value": "/code_files", "base": "workspace"}
        ],
        "required_checks": ["before_write", "before_transition"],
        "drift_routes": {"final_plan": "review", "code_files": "patch", "requirement": "plan", "deltas": "plan", "default": "patch"}
      },
      "verify": {
        "inputs": [
          {"id": "verification_contract", "kind": "metadata_pointer", "value": "/verification_contract", "required": false, "protected": true},
          {"id": "code_files", "kind": "metadata_files", "value": "/code_files", "base": "workspace", "required": false, "protected": true},
          {"id": "workspace_head", "kind": "workspace_git_head", "value": ".", "required": false, "protected": true}
        ],
        "outputs": [{"id": "verification_runs", "kind": "metadata_pointer", "value": "/verification_runs", "receipt_event": "verification_recorded"}],
        "required_checks": ["before_side_effect", "after_wait"],
        "drift_routes": {"verification_contract": "verify", "code_files": "deepcheck", "workspace_head": "merge", "default": "verify"}
      },
      "readme": {
        "inputs": [
          {"id": "final_plan", "kind": "ticket_file", "value": "03_plan_final.md", "required": true, "protected": true},
          {"id": "audit", "kind": "ticket_file", "value": "06_audit.md", "required": true, "protected": true}
        ],
        "outputs": [
          {"id": "readme", "kind": "ticket_file", "value": "07_readme.md"},
          {"id": "brief", "kind": "ticket_file", "value": "_brief.md"}
        ],
        "required_checks": ["before_write"],
        "drift_routes": {"final_plan": "review", "audit": "audit", "default": "readme"}
      },
      "worktree": {
        "inputs": [
          {"id": "active_checkout", "kind": "metadata_pointer", "value": "/active_checkout", "required": false, "protected": true},
          {"id": "submission_contracts", "kind": "metadata_pointer", "value": "/submission_contracts", "required": false, "protected": true},
          {"id": "workspace_head", "kind": "workspace_git_head", "value": ".", "required": false, "protected": true}
        ],
        "outputs": [
          {"id": "active_checkout", "kind": "metadata_pointer", "value": "/active_checkout", "receipt_event": "metadata_updated"},
          {"id": "checkout_history", "kind": "metadata_pointer", "value": "/checkout_history", "receipt_event": "metadata_updated"}
        ],
        "required_checks": ["before_side_effect", "after_wait"],
        "drift_routes": {"active_checkout": "worktree", "submission_contracts": "worktree", "workspace_head": "merge", "default": "worktree"}
      }
    },
    "operation_classes": {
      "read_only": {"auto_retry": true, "requires_idempotency": false, "ambiguous_start_action": "retry"},
      "managed_write": {"auto_retry": false, "requires_idempotency": true, "ambiguous_start_action": "verify_receipt"},
      "external_side_effect": {"auto_retry": false, "requires_idempotency": true, "ambiguous_start_action": "verify_receipt"},
      "destructive_hardware": {"auto_retry": false, "requires_idempotency": true, "ambiguous_start_action": "human_decision"}
    },
    "failure_policies": {
      "retryable_transport": {"action": "retry", "max_attempts": 3, "backoff_seconds": [0, 1, 3], "conclusion_ceiling": "degraded"},
      "capability_unavailable": {"action": "fallback", "max_attempts": 1, "backoff_seconds": [0], "conclusion_ceiling": "degraded"},
      "deterministic_failure": {"action": "repair_then_retry", "max_attempts": 1, "backoff_seconds": [0], "conclusion_ceiling": "blocked"},
      "policy_schema_security": {"action": "block", "max_attempts": 0, "backoff_seconds": [], "conclusion_ceiling": "blocked"},
      "ambiguous_side_effect": {"action": "verify_receipt", "max_attempts": 0, "backoff_seconds": [], "conclusion_ceiling": "blocked"},
      "destructive_risk": {"action": "human_decision", "max_attempts": 0, "backoff_seconds": [], "conclusion_ceiling": "blocked"}
    },
    "safety_overrides": {
      "external_side_effect": "即使错误看似 retryable，也必须先核对远端/设备回执，禁止自动重放。",
      "destructive_hardware": "任何失败均不自动重试，必须由人确认下一动作。",
      "managed_write": "仅在幂等键和写后校验均存在时允许人工或上层编排重试。"
    }
  },
  "state_machine": {
    "doc": "vNext 工单（metadata.schema_version=3）状态机真源。tools/icode_control.py transition 按此判定合法性；steps/*.md 的状态写回必须经 `python3 tools/icode_control.py transition --dir <out_dir> --to <status>`，禁止绕过直写（validate 会校验 metadata.status 与最后一条 state_changed 事件一致性）。legacy 工单（metadata 无 schema_version）为只读适配对象，不走 transition（validate 报 legacy-untracked 不阻断只读审计）。",
    "states": ["log_in_progress","log_done","init_in_progress","plan_done","review_in_progress","review_done","plan_finalized","code_in_progress","code_done","deepcheck_in_progress","deepcheck_done","completed","debug_in_progress","debug_done"],
    "terminal_states_of_ticket": ["completed","debug_done"],
    "transitions": [
      {"from": "log_in_progress", "to": "log_done"},
      {"from": "log_done", "to": "log_in_progress", "note": "用户质疑回退重查"},
      {"from": "init_in_progress", "to": "plan_done"},
      {"from": "log_done", "to": "plan_done", "note": "start/plan 复用已有 log 定稿"},
      {"from": "plan_done", "to": "review_in_progress"},
      {"from": "review_in_progress", "to": "review_done"},
      {"from": "review_done", "to": "review_in_progress", "note": "重新审查"},
      {"from": "review_done", "to": "plan_finalized", "note": "merge 定稿"},
      {"from": "plan_finalized", "to": "code_in_progress"},
      {"from": "code_in_progress", "to": "code_done"},
      {"from": "code_done", "to": "code_in_progress", "note": "重跑代码实施"},
      {"from": "code_done", "to": "deepcheck_in_progress"},
      {"from": "deepcheck_in_progress", "to": "deepcheck_done"},
      {"from": "deepcheck_done", "to": "deepcheck_in_progress", "note": "重新深检"},
      {"from": "deepcheck_done", "to": "completed", "note": "audit 完成；必须 --delivery-verdict 显式回填交付结论，禁止缺省推断"},
      {"from": "completed", "to": "review_in_progress", "note": "已完成工单按用户指令重新审查"},
      {"from": "debug_in_progress", "to": "debug_done"}
    ],
    "gate_policy": {
      "doc": "状态前移门禁分级：to 完成态（gated_targets）→ 依次运行三个 gate linter（vNext 工单一律 --strict），任一失败即 fail-closed 状态不前移；to 进行态（*_in_progress）→ 仅做状态机合法性判定，不跑 linter。completed 额外强制 delivery_verdict 显式回填。debug 孪生工单（metadata.debug=true）走 .debug 隔离域，不跑通用门禁。",
      "gated_targets": ["log_done","plan_done","review_done","plan_finalized","code_done","deepcheck_done","completed"],
      "step_by_target": {
        "log_done": "log",
        "plan_done": "plan",
        "review_done": "review",
        "plan_finalized": "merge",
        "code_done": "code",
        "deepcheck_done": "deepcheck",
        "completed": "audit"
      },
      "completed_step_by_target": {
        "log_done": "log",
        "plan_done": "1",
        "review_done": "2",
        "plan_finalized": "3",
        "code_done": "4",
        "deepcheck_done": "5",
        "completed": "6",
        "debug_done": "log"
      },
      "gate_linters": {
        "thinking_gate": ["python3","tools/lint_thinking_gate.py","--strict","--json"],
        "mcp_coverage": ["python3","tools/lint_mcp_coverage.py","--strict","--json"],
        "workflow_contract": ["python3","tools/lint_workflow_contract.py","--strict","--json"]
      },
      "completed_requires": "transition --to completed 必须携带 --delivery-verdict ∈ {verified,verification_pending,blocked,not_applicable}（交付分层契约：宿主验证通过不得自动映射为 verified）"
    },
    "close_phases": ["close_planned","archived","roots_verified","checkouts_removed","branches_removed","closed"],
    "close_phase_doc": "关闭分阶段状态（metadata.close_state）。每阶段幂等（重放同阶段=已应用），禁止跨阶段跳转；用 tools/icode_control.py close-phase 记录。archived 成功后控制根从源 out_dir 交接到 archive_path，roots_verified 起必须在归档根续跑，保证源 checkout 删除后仍可留痕。closed 为终态，重复 close 对已 closed 工单只回放摘要不重复清理。"
  }

}
