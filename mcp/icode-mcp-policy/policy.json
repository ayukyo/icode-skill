{
  "version": 1,
  "default": "deny",
  "servers": {
    "icode-evidence": {
      "operations": ["read"],
      "tools": ["describe_capabilities", "inspect_file", "read_evidence", "verify_digest", "build_timeline", "inspect_corpus"]
    },
    "icode-workspace": {
      "operations": ["read"],
      "tools": ["describe_capabilities", "resolve_project", "inspect_project_profile", "inspect_workspace", "inspect_repo_matrix", "inspect_build_inputs", "inspect_artifact"]
    },
    "icode-device-observe": {
      "operations": ["read"],
      "tools": ["describe_capabilities", "list_profiles", "observe_device", "collect_log_window", "compare_artifact"]
    },
    "icode-mcp-health": {
      "operations": ["read"],
      "tools": ["describe_capabilities", "inventory_servers", "validate_manifest", "probe_python_server", "scan_sensitive_payload", "diagnose_registration"]
    },
    "icode-mcp-policy": {
      "operations": ["read"],
      "tools": ["describe_capabilities", "list_step_policy", "evaluate_call", "validate_policy"]
    },
    "icode-local-index": {
      "operations": ["read", "managed_index_write"],
      "tools": ["describe_capabilities", "build_index", "query_index", "index_status"],
      "tool_operations": {
        "describe_capabilities": ["read"],
        "build_index": ["managed_index_write"],
        "query_index": ["read"],
        "index_status": ["read"]
      }
    },
    "icode-mail-observe": {
      "operations": ["read", "managed_evidence_write"],
      "tools": ["describe_capabilities", "list_mailboxes", "search_messages", "get_message", "get_thread", "save_attachment"],
      "tool_operations": {
        "describe_capabilities": ["read"],
        "list_mailboxes": ["read"],
        "search_messages": ["read"],
        "get_message": ["read"],
        "get_thread": ["read"],
        "save_attachment": ["managed_evidence_write"]
      }
    }
  },
  "steps": {
    "init": [
      {"server": "icode-local-index", "condition": "已有索引或仓库超过 500 个文本文件", "required": false},
      {"server": "icode-workspace", "condition": "多 Git 根或来源不明", "required": false},
      {"server": "icode-mail-observe", "condition": "无已登录浏览器且用户显式选择 IMAP 邮箱观察器处理邮件范围", "required": false}
    ],
    "log": [
      {"server": "icode-evidence", "condition": "存在日志或附件证据", "required": true},
      {"server": "icode-device-observe", "condition": "需要读取设备现状或日志", "required": false},
      {"server": "icode-local-index", "condition": "日志或源码集合较大", "required": false},
      {"server": "icode-mail-observe", "condition": "无已登录浏览器且用户显式选择 IMAP 邮箱观察器读取故障邮件或附件", "required": false}
    ],
    "plan": [
      {"server": "icode-workspace", "condition": "需确认仓库/分支/构建来源", "required": true},
      {"server": "icode-evidence", "condition": "计划引用外部事实或附件", "required": false},
      {"server": "icode-local-index", "condition": "大型仓库检索", "required": false},
      {"server": "icode-mail-observe", "condition": "无已登录浏览器且用户显式选择 IMAP 邮箱观察器取得计划输入", "required": false}
    ],
    "review": [
      {"server": "icode-evidence", "condition": "审查结论引用日志/文档", "required": false},
      {"server": "icode-workspace", "condition": "审查跨 Git 根或制品", "required": false}
    ],
    "merge": [
      {"server": "icode-workspace", "condition": "合并前检查多仓库状态", "required": true}
    ],
    "code": [
      {"server": "icode-workspace", "condition": "修改跨仓库/构建根", "required": true},
      {"server": "icode-local-index", "condition": "大型仓库符号候选检索", "required": false}
    ],
    "deepcheck": [
      {"server": "icode-evidence", "condition": "复核证据链", "required": true},
      {"server": "icode-workspace", "condition": "复核源码/制品来源", "required": true},
      {"server": "icode-local-index", "condition": "全仓检索超过常规 rg 范围", "required": false},
      {"server": "icode-mail-observe", "condition": "无已登录浏览器且用户显式选择 IMAP 邮箱观察器复核邮件身份或附件", "required": false}
    ],
    "audit": [
      {"server": "icode-evidence", "condition": "审计结论需要可回指证据", "required": true},
      {"server": "icode-workspace", "condition": "审计提交/构建/制品来源", "required": true},
      {"server": "icode-device-observe", "condition": "设备结果进入验收边界", "required": false},
      {"server": "icode-mail-observe", "condition": "无已登录浏览器且用户显式选择 IMAP 邮箱观察器审计邮件证据", "required": false}
    ],
    "readme": [
      {"server": "icode-evidence", "condition": "README 引用文档或制品事实", "required": false}
    ],
    "doc": [
      {"server": "icode-evidence", "condition": "文档语料入库与 hash 回指", "required": true},
      {"server": "icode-local-index", "condition": "文档语料超过 50 个文件", "required": false},
      {"server": "icode-mail-observe", "condition": "无已登录浏览器且用户显式选择 IMAP 邮箱观察器取得文档输入", "required": false}
    ],
    "docx": [
      {"server": "icode-evidence", "condition": "P1 交付引用工单、知识库、日志、附件或外部文档，需 hash 回指", "required": false},
      {"server": "icode-local-index", "condition": "P1 文档语料超过常规 rg 范围", "required": false}
    ],
    "ppt": [
      {"server": "icode-evidence", "condition": "幻灯片引用日志/文档/图片来源", "required": false}
    ],
    "patch": [
      {"server": "icode-evidence", "condition": "补丁由新增证据触发", "required": true},
      {"server": "icode-workspace", "condition": "补丁涉及构建/仓库来源", "required": true},
      {"server": "icode-device-observe", "condition": "监听或设备复验", "required": false}
    ],
    "verify": [
      {"server": "icode-evidence", "condition": "验证输出需 hash/回指", "required": true},
      {"server": "icode-workspace", "condition": "验证源码与制品一致性", "required": true},
      {"server": "icode-device-observe", "condition": "真机验收", "required": false},
      {"server": "icode-mail-observe", "condition": "无已登录浏览器且用户显式选择 IMAP 邮箱观察器验证邮件证据", "required": false}
    ],
    "worktree": [
      {"server": "icode-workspace", "condition": "任何 worktree 生命周期操作", "required": true}
    ],
    "install": [
      {"server": "icode-mcp-health", "condition": "MCP 安装或升级后", "required": true},
      {"server": "icode-mcp-policy", "condition": "路由策略安装或升级后", "required": true}
    ],
    "learn": [
      {"server": "icode-local-index", "condition": "仅查询已有索引，不联网补历史", "required": false, "operations": ["read"]}
    ],
    "study": [
      {"server": "icode-workspace", "condition": "工单实现根或多仓身份需核对", "required": false},
      {"server": "icode-local-index", "condition": "大仓库符号检索，仅查询已有索引", "required": false, "operations": ["read"]}
    ],
    "list": [
      {"server": "icode-local-index", "condition": "查询已有本地索引", "required": false, "operations": ["read"]}
    ]
  },
  "transport": {
    "server": "icode-local",
    "members": {
      "workspace": "icode-workspace",
      "evidence": "icode-evidence",
      "index": "icode-local-index",
      "health": "icode-mcp-health",
      "policy": "icode-mcp-policy"
    },
    "tools": {
      "workspace_describe_capabilities": {
        "server": "icode-workspace",
        "tool": "describe_capabilities"
      },
      "workspace_resolve_project": {
        "server": "icode-workspace",
        "tool": "resolve_project"
      },
      "workspace_inspect_project_profile": {
        "server": "icode-workspace",
        "tool": "inspect_project_profile"
      },
      "workspace_inspect_workspace": {
        "server": "icode-workspace",
        "tool": "inspect_workspace"
      },
      "workspace_inspect_repo_matrix": {
        "server": "icode-workspace",
        "tool": "inspect_repo_matrix"
      },
      "workspace_inspect_build_inputs": {
        "server": "icode-workspace",
        "tool": "inspect_build_inputs"
      },
      "workspace_inspect_artifact": {
        "server": "icode-workspace",
        "tool": "inspect_artifact"
      },
      "evidence_describe_capabilities": {
        "server": "icode-evidence",
        "tool": "describe_capabilities"
      },
      "evidence_inspect_file": {
        "server": "icode-evidence",
        "tool": "inspect_file"
      },
      "evidence_read_evidence": {
        "server": "icode-evidence",
        "tool": "read_evidence"
      },
      "evidence_verify_digest": {
        "server": "icode-evidence",
        "tool": "verify_digest"
      },
      "evidence_build_timeline": {
        "server": "icode-evidence",
        "tool": "build_timeline"
      },
      "evidence_inspect_corpus": {
        "server": "icode-evidence",
        "tool": "inspect_corpus"
      },
      "index_describe_capabilities": {
        "server": "icode-local-index",
        "tool": "describe_capabilities"
      },
      "index_build_index": {
        "server": "icode-local-index",
        "tool": "build_index"
      },
      "index_query_index": {
        "server": "icode-local-index",
        "tool": "query_index"
      },
      "index_index_status": {
        "server": "icode-local-index",
        "tool": "index_status"
      },
      "health_describe_capabilities": {
        "server": "icode-mcp-health",
        "tool": "describe_capabilities"
      },
      "health_inventory_servers": {
        "server": "icode-mcp-health",
        "tool": "inventory_servers"
      },
      "health_validate_manifest": {
        "server": "icode-mcp-health",
        "tool": "validate_manifest"
      },
      "health_probe_python_server": {
        "server": "icode-mcp-health",
        "tool": "probe_python_server"
      },
      "health_scan_sensitive_payload": {
        "server": "icode-mcp-health",
        "tool": "scan_sensitive_payload"
      },
      "health_diagnose_registration": {
        "server": "icode-mcp-health",
        "tool": "diagnose_registration"
      },
      "policy_describe_capabilities": {
        "server": "icode-mcp-policy",
        "tool": "describe_capabilities"
      },
      "policy_list_step_policy": {
        "server": "icode-mcp-policy",
        "tool": "list_step_policy"
      },
      "policy_evaluate_call": {
        "server": "icode-mcp-policy",
        "tool": "evaluate_call"
      },
      "policy_validate_policy": {
        "server": "icode-mcp-policy",
        "tool": "validate_policy"
      },
      "describe_capabilities": {
        "routes": [
          {
            "server": "icode-workspace",
            "tool": "describe_capabilities"
          },
          {
            "server": "icode-evidence",
            "tool": "describe_capabilities"
          },
          {
            "server": "icode-local-index",
            "tool": "describe_capabilities"
          },
          {
            "server": "icode-mcp-health",
            "tool": "describe_capabilities"
          },
          {
            "server": "icode-mcp-policy",
            "tool": "describe_capabilities"
          }
        ]
      }
    }
  }
}
