#!/usr/bin/env python3
"""
serena-doctor: 项目级 serena 配置治理工具

自动检测项目语言，补全 .serena/project.yml 的 language_servers 配置，
确保 C++/Python/TypeScript 等项目的 LSP 可被 serena 正确启用。

用法:
  serena-doctor init <path> [--dry-run]    新建项目 serena 配置
  serena-doctor fix <path> [--dry-run]     已有项目, 补全缺失的语言
  serena-doctor --all [--dry-run]          批量体检 + 自动修复所有已注册项目

示例:
  serena-doctor init ./my-project
  serena-doctor fix ./my-project
  serena-doctor --all
  serena-doctor --all --dry-run         # 只报告不修

设计:
  init 调用 serena 原生的 project create + --language 参数生成骨架,
  fix 直接改 yaml 补 language_servers (不破坏原生骨架的其他字段),
  --all 遍历 ~/.serena/serena_config.yml 的 projects 列表逐个 fix。
"""

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import List, Optional, Set, Tuple

try:
    import yaml
except ImportError:
    yaml = None  # type: ignore[assignment]


# ── 常量 ──────────────────────────────────────────────────────────────────

SERENA_CONFIG_PATH = Path.home() / ".serena" / "serena_config.yml"

# 扫描时跳过的目录（避免进入 build/ node_modules/ 等巨量文件区）
IGNORED_DIRS: Set[str] = {
    "build", "install", ".git", "node_modules", "__pycache__",
    "venv", ".venv", "dist", "target", "bin", "obj", ".cache",
    ".icode_output", ".worktree", ".worktrees",
    "third_party", "third-party", "external", "3rdparty", "vendor",
    "cmake-build-debug", "cmake-build-release", "out",
}

# 构建系统标志文件 → 语言（强信号，顶层文件检测）
BUILD_SIGNALS: dict = {
    "cpp": [
        "CMakeLists.txt", "Makefile", ".clang-format",
        "compile_commands.json", "compile_flags.txt",
    ],
    "python": [
        "setup.py", "setup.cfg", "pyproject.toml",
        "requirements.txt", "Pipfile", "tox.ini",
    ],
    "typescript": [
        "package.json", "tsconfig.json", "tsconfig.base.json",
        "jsconfig.json",
    ],
    "rust": ["Cargo.toml", "Cargo.lock"],
    "go": ["go.mod", "go.sum"],
    "java": [
        "pom.xml", "build.gradle", "build.gradle.kts",
        "settings.gradle", "settings.gradle.kts",
    ],
    "ruby": ["Gemfile", "Rakefile"],
    "swift": ["Package.swift"],
    "kotlin": ["build.gradle.kts", "settings.gradle.kts"],
    "csharp": ["*.csproj"],  # 特殊处理：glob 模式
}

# 文件扩展名 → 语言（弱信号，基于文件数统计）
EXT_TO_LANG: dict = {
    ".cpp": "cpp", ".cc": "cpp", ".cxx": "cpp",
    ".h": "cpp", ".hpp": "cpp", ".hxx": "cpp",
    ".c": "cpp",
    ".py": "python", ".pyi": "python",
    ".ts": "typescript", ".tsx": "typescript",
    ".js": "typescript", ".jsx": "typescript",
    ".mjs": "typescript", ".cjs": "typescript",
    ".rs": "rust",
    ".go": "go",
    ".java": "java",
    ".cs": "csharp",
    ".rb": "ruby",
    ".swift": "swift",
    ".kt": "kotlin", ".kts": "kotlin",
    ".sh": "bash", ".bash": "bash",
    ".zsh": "bash",
}

# 扩展名统计确认阈值（至少 N 个文件才确认该语言）
EXT_THRESHOLD = 5


# ── 工具函数 ──────────────────────────────────────────────────────────────

def eprint(*args, **kwargs) -> None:
    """打印到 stderr"""
    print(*args, file=sys.stderr, **kwargs)


def _find_serena() -> Optional[str]:
    """查找 serena 命令路径"""
    serena = shutil.which("serena")
    if serena:
        return serena
    # 常见 fallback 路径
    candidates = [
        Path.home() / ".local" / "bin" / "serena",
        Path.home() / ".cargo" / "bin" / "serena",
    ]
    for c in candidates:
        if c.is_file() and os.access(c, os.X_OK):
            return str(c)
    return None


# ── 语言探测 ──────────────────────────────────────────────────────────────

def detect_languages(project_path: Path) -> Set[str]:
    """扫描项目根目录，推断需要哪些 language server

    策略（两层）：
      1. 强信号：顶层构建标志文件（CMakeLists.txt → cpp, package.json → typescript …）
      2. 弱信号：文件扩展名统计（>5 个 .py → python，>5 个 .cpp → cpp …）
    """
    if not project_path.is_dir():
        return {"bash"}

    entries = _safe_listdir(project_path)
    filenames = {e.name for e in entries if e.is_file()}
    dirnames = {e.name for e in entries if e.is_dir()}

    langs: Set[str] = set()

    # ── 层 1：构建标志文件 ──
    for lang, signals in BUILD_SIGNALS.items():
        if lang == "csharp":
            # 特殊处理：glob 模式 *.csproj
            if any(f.endswith(".csproj") for f in filenames):
                langs.add("csharp")
        else:
            if any(s in filenames for s in signals):
                langs.add(lang)

    # ── 层 2：扩展名统计 ──
    ext_counts = _scan_extensions(project_path, dirnames)
    for ext, count in ext_counts.items():
        if count >= EXT_THRESHOLD:
            lang = EXT_TO_LANG.get(ext)
            if lang:
                langs.add(lang)

    # ── 默认兜底 ──
    if not langs:
        langs.add("bash")

    return langs


def _safe_listdir(path: Path) -> List[Path]:
    """安全的目录列举，避免权限错误"""
    try:
        return list(path.iterdir())
    except (PermissionError, OSError):
        return []


def _scan_extensions(root: Path, top_dirnames: Set[str]) -> dict:
    """递归扫描文件扩展名，跳过 IGNORED_DIRS

    限制最多扫描 5000 个文件以防大项目卡死。
    """
    counts: dict = {}
    scanned = 0
    max_scan = 5000

    try:
        for dirpath, dirnames, filenames in os.walk(root):
            # 跳过被忽略的目录
            dirnames[:] = [
                d for d in dirnames
                if d not in IGNORED_DIRS
            ]
            for fname in filenames:
                if fname.startswith("."):
                    continue
                ext = Path(fname).suffix.lower()
                if ext:
                    counts[ext] = counts.get(ext, 0) + 1
                scanned += 1
                if scanned >= max_scan:
                    return counts
    except (PermissionError, OSError):
        pass

    return counts


# ── serena project create 调用 ──────────────────────────────────────────

def _run_serena_create(project_path: Path, languages: Set[str], dry_run: bool) -> bool:
    """调用 serena project create 生成配置骨架"""
    serena = _find_serena()
    if not serena:
        eprint("❌ serena 命令未找到")
        eprint("   请先安装 serena 并确保在 PATH 中")
        return False

    cmd = [serena, "project", "create", str(project_path)]
    for lang in sorted(languages):
        cmd.extend(["--language", lang])

    if dry_run:
        print(f"  [dry-run] 将执行: {' '.join(cmd)}")
        return True

    try:
        result = subprocess.run(
            cmd, capture_output=True, text=True, timeout=60,
        )
        if result.returncode == 0:
            print(f"  ✅ serena project create 成功: {result.stdout.strip()}")
            return True
        else:
            stderr = result.stderr.strip()
            if "already exists" in stderr:
                print("  ⚠️  project.yml 已存在，跳过 serena create")
                print(f"     提示: 用 'serena-doctor fix {project_path}' 补全语言")
                return True
            eprint(f"❌ serena create 失败: {stderr}")
            return False
    except subprocess.TimeoutExpired:
        eprint("❌ serena create 超时 (60s)")
        return False


# ── compile_commands.json 软链 ──────────────────────────────────────────

def _ensure_compile_commands_symlink(project_path: Path, dry_run: bool) -> Optional[str]:
    """确保 C++ 项目有 compile_commands.json 软链

    返回描述信息，或 None 表示无变化。
    """
    target = project_path / "compile_commands.json"

    # 已有有效软链
    if target.is_symlink():
        if target.resolve().exists():
            return None  # 没问题，无变化
        else:
            # 断链，需要重建
            target.unlink(missing_ok=True)

    # 已有真实文件
    if target.exists():
        return None  # 已有文件，不动

    # 找 build/compile_commands.json
    build_cc = project_path / "build" / "compile_commands.json"
    if not build_cc.exists():
        # 尝试其他常见位置
        for candidate in sorted(project_path.glob("*/compile_commands.json")):
            if candidate.parent.name != "build":
                build_cc = candidate
                break
        else:
            return None  # 找不到，跳过

    rel_path = os.path.relpath(build_cc, project_path)
    if dry_run:
        return f"需创建软链: compile_commands.json → {rel_path}"

    target.symlink_to(rel_path)
    return f"创建软链: compile_commands.json → {rel_path}"


# ── init 命令 ────────────────────────────────────────────────────────────

def cmd_init(project_path: Path, dry_run: bool) -> int:
    """新建项目 serena 配置"""
    project_path = project_path.resolve()
    print(f"\n{'='*60}")
    print(f"  serena-doctor init: {project_path}")
    print(f"{'='*60}")

    if not project_path.is_dir():
        eprint(f"❌ 路径不存在: {project_path}")
        return 1

    # 检查是否已有配置
    project_yml = project_path / ".serena" / "project.yml"
    if project_yml.exists() and not dry_run:
        eprint(f"⚠️  .serena/project.yml 已存在")
        eprint(f"   提示: 用 'serena-doctor fix {project_path}' 补全语言")
        return 1

    # 探测语言
    langs = detect_languages(project_path)
    print(f"  探测到的语言: {', '.join(sorted(langs))}")

    # 调用 serena create
    if not _run_serena_create(project_path, langs, dry_run):
        return 1

    # C++ 软链
    if "cpp" in langs:
        msg = _ensure_compile_commands_symlink(project_path, dry_run)
        if msg:
            print(f"  {msg}")

    if dry_run:
        print(f"  [dry-run] 以上为预览，未做任何修改")

    print(f"  ✅ init 完成")
    return 0


# ── fix 命令 ────────────────────────────────────────────────────────────

def cmd_fix(project_path: Path, dry_run: bool) -> int:
    """已有项目补全语言"""
    project_path = project_path.resolve()
    print(f"\n{'='*60}")
    print(f"  serena-doctor fix: {project_path}")
    print(f"{'='*60}")

    if not project_path.is_dir():
        eprint(f"❌ 路径不存在: {project_path}")
        return 1

    project_yml = project_path / ".serena" / "project.yml"
    if not project_yml.exists():
        eprint(f"❌ .serena/project.yml 不存在")
        eprint(f"   提示: 先用 'serena-doctor init {project_path}' 新建")
        return 1

    # 读取现有配置
    with open(project_yml) as f:
        config = yaml.safe_load(f)

    if not isinstance(config, dict):
        eprint("❌ project.yml 格式错误（不是字典）")
        return 1

    current_langs = set(config.get("language_servers", []))
    detected_langs = detect_languages(project_path)

    missing = detected_langs - current_langs
    extra = current_langs - detected_langs
    has_changes = bool(missing)

    print(f"  当前配置的语言:  {', '.join(sorted(current_langs)) or '(空)'}")
    print(f"  实际探测到的语言: {', '.join(sorted(detected_langs))}")

    if missing:
        print(f"  ⚠️  缺失语言: {', '.join(sorted(missing))}")
    else:
        print(f"  ✅ language_servers 已齐全")

    if extra:
        print(f"  ℹ️  多余语言（已声明但未检测到）: {', '.join(sorted(extra))}")
        print(f"     保留不做自动删除（可能是用户手动配置的）")

    # 补 language_servers
    if missing and not dry_run:
        # 备份
        backup_path = project_yml.with_suffix(".yml.bak")
        shutil.copy2(project_yml, backup_path)
        print(f"  📦 已备份: {backup_path.name}")

        # 合并并写回
        config["language_servers"] = sorted(current_langs | detected_langs)
        with open(project_yml, "w") as f:
            yaml.dump(config, f, allow_unicode=True, default_flow_style=False)
        print(f"  ✅ 补全 language_servers: {', '.join(sorted(missing))}")

    # C++ 软链
    if "cpp" in current_langs or "cpp" in detected_langs:
        msg = _ensure_compile_commands_symlink(project_path, dry_run)
        if msg:
            print(f"  {msg}")

    if dry_run and has_changes:
        print(f"  [dry-run] 以上为预览，未做任何修改")
        print(f"  需补全的语言: {', '.join(sorted(missing))}")

    if not has_changes and not ("cpp" in current_langs or "cpp" in detected_langs):
        print(f"  ✅ 项目配置已健康，无需修改")

    return 0


# ── --all 命令 ──────────────────────────────────────────────────────────

def cmd_all(dry_run: bool) -> int:
    """批量处理所有已注册项目"""
    print(f"\n{'='*60}")
    print(f"  serena-doctor --all (批量体检)")
    print(f"  模式: {'dry-run (只报告)' if dry_run else '自动修复'}")
    print(f"{'='*60}")

    projects = _get_all_projects()
    if not projects:
        print(f"  ℹ️  ~/.serena/serena_config.yml 中未找到已注册项目")
        print(f"    （或配置文件不存在）")
        return 0

    print(f"  找到 {len(projects)} 个已注册项目:\n")

    results = []
    for p in projects:
        if not p.is_dir():
            results.append({"path": str(p), "status": "skipped", "reason": "目录不存在"})
            continue

        project_yml = p / ".serena" / "project.yml"
        if not project_yml.exists():
            results.append({"path": str(p), "status": "skipped", "reason": "无 .serena/project.yml"})
            continue

        # 读取现有配置
        with open(project_yml) as f:
            config = yaml.safe_load(f)
        current_langs = set(config.get("language_servers", [])) if isinstance(config, dict) else set()
        detected_langs = detect_languages(p)
        missing = detected_langs - current_langs

        if not missing and "cpp" not in current_langs and "cpp" not in detected_langs:
            results.append({"path": str(p), "status": "healthy", "current": sorted(current_langs)})
            continue

        # 检查软链
        cc_symlink_ok = None
        if "cpp" in current_langs or "cpp" in detected_langs:
            target = p / "compile_commands.json"
            if target.is_symlink() and target.resolve().exists():
                cc_symlink_ok = True
            elif target.exists():
                cc_symlink_ok = True
            else:
                cc_symlink_ok = False

        if missing:
            if not dry_run:
                backup_path = project_yml.with_suffix(".yml.bak")
                shutil.copy2(project_yml, backup_path)
                config["language_servers"] = sorted(current_langs | detected_langs)
                with open(project_yml, "w") as f:
                    yaml.dump(config, f, allow_unicode=True, default_flow_style=False)

                # 同时修复 C++ 软链（missing 分支不会进入 elif cc_symlink_ok）
                if cc_symlink_ok is False:
                    _ensure_compile_commands_symlink(p, dry_run=False)

            results.append({
                "path": str(p),
                "status": "fixed",
                "current": sorted(current_langs),
                "missing": sorted(missing),
                "detected": sorted(detected_langs),
                "cc_symlink": cc_symlink_ok,
            })
        elif cc_symlink_ok is False:
            if not dry_run:
                _ensure_compile_commands_symlink(p, dry_run=False)
            results.append({
                "path": str(p),
                "status": "cc_symlink_fixed",
                "current": sorted(current_langs),
                "cc_symlink": False,
            })
        else:
            results.append({
                "path": str(p),
                "status": "healthy",
                "current": sorted(current_langs),
                "cc_symlink": cc_symlink_ok,
            })

    # 汇总报告
    print(f"{'─'*60}")
    print(f"  【汇总报告】")
    print(f"{'─'*60}")

    healthy = 0
    fixed = 0
    skipped = 0
    for r in results:
        tag = {
            "healthy": "✅",
            "fixed": "🔧",
            "cc_symlink_fixed": "🔧",
            "skipped": "⏭️",
        }.get(r["status"], "❓")

        line = f"  {tag} {r['path']}"
        if r["status"] == "healthy":
            line += f"  (语言: {', '.join(r.get('current', []))})"
            healthy += 1
        elif r["status"] == "fixed":
            line += f"\n     补全: {', '.join(r['missing'])}"
            fixed += 1
        elif r["status"] == "cc_symlink_fixed":
            line += f"  (补了 compile_commands.json 软链)"
            fixed += 1
        elif r["status"] == "skipped":
            line += f"  ({r.get('reason', '跳过')})"
            skipped += 1
        print(line)

    print(f"\n  📊 总数: {len(results)} | ✅ 健康: {healthy} | 🔧 修复: {fixed} | ⏭️ 跳过: {skipped}")

    if dry_run and fixed > 0:
        print(f"  [dry-run] 加 --dry-run 时为预览，未做实际修改")

    return 0


def _get_all_projects() -> List[Path]:
    """从 serena 全局配置读取所有已注册项目"""
    if not SERENA_CONFIG_PATH.exists():
        return []

    try:
        with open(SERENA_CONFIG_PATH) as f:
            config = yaml.safe_load(f)
    except Exception:
        return []

    if not isinstance(config, dict):
        return []

    raw = config.get("projects", [])
    if not isinstance(raw, list):
        return []

    # 去重 + 保留顺序
    seen: set = set()
    paths: List[Path] = []
    for p in raw:
        if not p or not isinstance(p, str):
            continue
        resolved = str(Path(p).resolve())
        if resolved not in seen:
            seen.add(resolved)
            paths.append(Path(p))
    return paths


# ── 主入口 ────────────────────────────────────────────────────────────────

def parse_args(argv: List[str]) -> argparse.Namespace:
    """解析命令行参数"""
    # 判断是否传了 --all（与子命令互斥）
    has_all = "--all" in argv
    has_dry_run = "--dry-run" in argv

    if has_all:
        # --all 模式：不解析子命令
        parser = argparse.ArgumentParser(
            description="serena-doctor: 项目级 serena 配置治理工具",
            formatter_class=argparse.RawDescriptionHelpFormatter,
            epilog="""
子命令（不与 --all 同时使用）:
  init <path>    新建项目 serena 配置
  fix <path>     已有项目补全语言

示例:
  serena-doctor init ./my-project
  serena-doctor fix ./my-project
  serena-doctor --all
  serena-doctor --all --dry-run
""",
        )
        parser.add_argument(
            "--all", action="store_true",
            help="批量体检 + 自动修复所有已注册项目",
        )
        parser.add_argument(
            "--dry-run", action="store_true",
            help="只报告不修",
        )
        return parser.parse_args(argv)

    # 子命令模式
    parser = argparse.ArgumentParser(
        description="serena-doctor: 项目级 serena 配置治理工具",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
示例:
  serena-doctor init ./my-project
  serena-doctor fix ./my-project
  serena-doctor --all
  serena-doctor --all --dry-run
""",
    )
    subparsers = parser.add_subparsers(dest="command", help="子命令")

    init_parser = subparsers.add_parser("init", help="新建项目 serena 配置")
    init_parser.add_argument("path", help="项目路径")
    init_parser.add_argument("--dry-run", action="store_true", help="只报告不修")

    fix_parser = subparsers.add_parser("fix", help="已有项目补全语言")
    fix_parser.add_argument("path", help="项目路径")
    fix_parser.add_argument("--dry-run", action="store_true", help="只报告不修")

    return parser.parse_args(argv)


def main() -> int:
    # 依赖检查
    if yaml is None:
        eprint("❌ 缺少 pyyaml 模块，请安装: pip install pyyaml")
        return 1

    argv = sys.argv[1:] if len(sys.argv) > 1 else ["--help"]

    # 快速检查 --all
    if "--all" in argv:
        dry_run = "--dry-run" in argv
        return cmd_all(dry_run=dry_run)

    args = parse_args(argv)

    if args.command == "init":
        return cmd_init(Path(args.path), dry_run=args.dry_run)
    elif args.command == "fix":
        return cmd_fix(Path(args.path), dry_run=args.dry_run)
    else:
        # 无命令 → 显示 help
        parse_args(["--help"])
        return 0


if __name__ == "__main__":
    sys.exit(main())