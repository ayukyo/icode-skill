# Keep scripts executable by Linux/WSL even with Windows core.autocrlf=true.
*.sh text eol=lf
*.py text eol=lf
# Vendored browser resources are pinned by upstream byte hashes, including licenses.
agent_runtime/icode_agent/ui_assets/vendor/* -text
# Generated upstream bundles contain intentional template-literal whitespace;
# verify their exact bytes using vendor/manifest.json instead of reformatting.
agent_runtime/icode_agent/ui_assets/vendor/*.js -whitespace
agent_runtime/icode_agent/ui_assets/vendor/manifest.json text eol=lf
