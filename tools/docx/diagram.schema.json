{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ICODE SVG diagram provenance",
  "type": "object",
  "required": ["source", "sha256", "source_format", "fallback_png", "fallback_sha256", "embedded_format", "vector_preserved", "view_box", "pixel_width", "pixel_height", "renderer", "font_files", "validation"],
  "properties": {
    "source": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_format": {"const": "svg"},
    "fallback_png": {"type": "string", "minLength": 1},
    "fallback_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "embedded_format": {"enum": ["png_fallback", "svg_with_png_fallback"]},
    "vector_preserved": {"type": "boolean"},
    "view_box": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "pixel_width": {"type": "integer", "minimum": 1, "maximum": 8192},
    "pixel_height": {"type": "integer", "minimum": 1, "maximum": 8192},
    "renderer": {"type": "object", "required": ["name", "version"]},
    "font_files": {"type": "array", "items": {"type": "object", "required": ["path", "sha256", "families"]}},
    "validation": {"type": "object", "required": ["svg_structure", "fallback_render", "visual_review"]}
  },
  "allOf": [
    {"if": {"properties": {"embedded_format": {"const": "png_fallback"}}}, "then": {"properties": {"vector_preserved": {"const": false}}}},
    {"if": {"properties": {"embedded_format": {"const": "svg_with_png_fallback"}}}, "then": {"properties": {"vector_preserved": {"const": true}, "consumer_compatibility": {"const": "pending"}}, "required": ["consumer_compatibility"]}}
  ]
}
